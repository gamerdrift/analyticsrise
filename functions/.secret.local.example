# =========================================================================
# Local Secret Manager Emulation Template for Firebase Cloud Functions
# For local testing with `firebase emulators:start`, copy this file to:
# `functions/.secret.local`
#
# DO NOT COMMIT actual secret values to git. `functions/.secret.local` is gitignored.
# =========================================================================
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
