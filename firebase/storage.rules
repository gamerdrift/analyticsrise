rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // =========================================================================
    // Core Helper Functions
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // Storage Paths Rules
    // =========================================================================

    // 1. User Avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 2. User Career Uploads (Resumes/PDFs)
    match /resumes/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // 3. Digital Certificates (Platform-Managed Assets)
    // Publicly readable for cryptographic verification and portfolio sharing.
    // Client write access is STRICTLY FORBIDDEN (zero-trust).
    // Issued exclusively by trusted backend Cloud Functions / Firebase Admin SDK.
    match /certificates/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Course Datasets (Platform-Managed Assets)
    // Readable by authenticated platform learners.
    // Client write access is STRICTLY FORBIDDEN (zero-trust).
    // Managed exclusively by trusted backend Cloud Functions / Firebase Admin SDK.
    match /datasets/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
