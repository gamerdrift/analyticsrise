rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Core authentication helpers
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userProfileExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        userProfileExists() &&
        getUserProfile().profile.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isInstructor() {
      return hasRole('instructor') || isAdmin();
    }

    function isRecruiter() {
      return hasRole('recruiter') || isAdmin();
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // Users can read only themselves.
      // Administrators can read any user.
      allow read: if isOwner(userId) || isAdmin();

      // Initial profile creation belongs to the authenticated user.
      allow create: if isOwner(userId);

      // Users may update their own profile, but cannot modify
      // their authorization role. Administrators may update users.
      allow update: if isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.profile.role ==
            resource.data.profile.role
        );

      // Only administrators may delete user profiles.
      allow delete: if isAdmin();
    }


    // ============================================================
    // PYTHON LAB
    // /users/{uid}/pythonLab/{missionId}
    // ============================================================

    match /users/{userId}/pythonLab/{missionId} {
      allow read, write: if isOwner(userId);
    }


    // ============================================================
    // DASHBOARD WIDGETS
    // ============================================================

    match /dashboardWidgets/{userId} {

      // The application currently reads these documents.
      // No client-side write access is granted.
      allow read: if isOwner(userId) || isAdmin();

      allow write: if false;
    }


    // ============================================================
    // MISSIONS
    // ============================================================

    match /missions/{missionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }


    // ============================================================
    // COURSES
    // ============================================================

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isInstructor();
    }


    // ============================================================
    // DATASETS
    // ============================================================

    match /datasets/{datasetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }


    // ============================================================
    // CERTIFICATES
    // ============================================================

    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // SUBMISSIONS
    // ============================================================

    match /submissions/{submissionId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // ASSESSMENTS
    // ============================================================

    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if isInstructor();
    }


    // ============================================================
    // COMPANIES
    // ============================================================

    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isRecruiter() || isAdmin();
    }


    // ============================================================
    // JOBS
    // ============================================================

    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow write: if isRecruiter() || isAdmin();
    }


    // ============================================================
    // RESUMES
    // ============================================================

    match /resumes/{resumeId} {
      allow read: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if
        isOwner(resource.data.ownerId) || isAdmin();
    }


    // ============================================================
    // PORTFOLIO
    // ============================================================

    match /portfolio/{portfolioId} {
      allow read: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if
        isOwner(resource.data.ownerId) || isAdmin();
    }


    // ============================================================
    // APPLICATIONS
    // ============================================================

    match /applications/{applicationId} {
      allow read: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if
        isOwner(resource.data.ownerId) || isAdmin();
    }


    // ============================================================
    // COMMUNITY
    //
    // The current /community page is static/demo content.
    // The legacy Admin-SDK API files are not currently called by
    // the application. No new client permissions are introduced.
    // ============================================================

    match /posts/{postId} {
      allow read: if false;
      allow write: if false;

      match /comments/{commentId} {
        allow read, write: if false;
      }

      match /likes/{likeId} {
        allow read, write: if false;
      }
    }


    // ============================================================
    // BILLING, SUBSCRIPTIONS & ENTITLEMENTS (RAZORPAY)
    //
    // Authoritative billing collections are managed exclusively by
    // Firebase Admin SDK inside Cloud Functions.
    // Client SDK write access is STRICTLY FORBIDDEN.
    // Users may read only their own subscriptions/entitlements/orders.
    // ============================================================

    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /entitlements/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }


    // ============================================================
    // REVENUERISEAI — CONVERSATIONS & USAGE QUOTAS
    //
    // Conversations and messages are strictly isolated per user.
    // Usage quotas are strictly write-forbidden to client SDKs
    // (managed authoritatively by Cloud Functions Admin SDK).
    // ============================================================

    match /aiConversations/{conversationId} {
      allow read, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/aiConversations/$(conversationId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }
    }

    match /aiUsage/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
  }
}